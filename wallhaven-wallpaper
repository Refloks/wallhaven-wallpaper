#!/usr/bin/env bash

set -euo pipefail

DIR="$HOME/Pictures/wallhaven"

API="https://wallhaven.cc/api/v1/search"
API_KEY_FILE="$HOME/.config/wallhaven/api-key"

HISTORY_DIR="$HOME/.config/wallhaven"
# One line per used wallpaper: "<id><TAB><unix time it was used>".
USED_IDS="$HISTORY_DIR/used-ids"

PAGE_SAMPLES=5
QUALITY_PERCENT=50
MIN_WIDTH=1920
MIN_HEIGHT=1080

# 100 = SFW only, 110 = SFW + sketchy.
PURITY=100

# A used wallpaper is not shown again for this many days.
BLOCK_DAYS=365

# If every search is exhausted, fall back to only avoiding this many
# of the most recently used wallpapers.
FALLBACK_RECENT=40

# How many downloaded wallpapers to keep in $DIR (newest first).
KEEP_FILES=30

# How long to wait for the network at login before giving up.
NETWORK_WAIT_SECONDS=60

# Wallhaven categories as three 0/1 flags: general, anime, people.
CATEGORIES=111

# Accepted aspect ratios, comma-separated: "landscape", "portrait", or exact
# ratios like "16x9,16x10". Empty = any.
RATIOS="landscape"

# Optional tags to pick from, as "Name|tag_id". Each run tries them in a
# random order. Empty = search all of Wallhaven. Set this in the config file
# rather than here; see config.example.
TAGS=()

# Any setting above can be overridden in this file (plain Bash).
CONFIG_FILE="$HOME/.config/wallhaven/config"

if [[ -f "$CONFIG_FILE" ]]; then
    if ! bash -n "$CONFIG_FILE"; then
        echo "Syntax error in $CONFIG_FILE, not running."
        exit 1
    fi
    # shellcheck source=/dev/null
    source "$CONFIG_FILE"
fi

# Delete all but the newest $KEEP_FILES wallpapers, never the current one.
cleanup_old() {
    local current="$1"

    find "$DIR" -maxdepth 1 -type f -name 'wallpaper-*' ! -name '*.part' \
        -printf '%T@\t%p\n' |
        sort -rn |
        tail -n +"$(( KEEP_FILES + 1 ))" |
        cut -f2- |
        while IFS= read -r old; do
            [[ "$old" == "$current" ]] && continue
            rm -f -- "$old"
        done
}

mkdir -p "$DIR" "$HISTORY_DIR"

# Only change the wallpaper once per day. Run with --force to change it anyway.
LAST_CHANGED="$HISTORY_DIR/last-changed"
TODAY="$(date +%F)"

if [[ "${1:-}" != "--force" && -r "$LAST_CHANGED" \
      && "$(< "$LAST_CHANGED")" == "$TODAY" ]]; then
    current_uri="$(gsettings get org.gnome.desktop.background picture-uri | tr -d "'")"
    if [[ -f "${current_uri#file://}" ]]; then
        echo "Wallpaper already changed today ($TODAY), keeping it."
        echo "Run with --force to change it anyway."
        exit 0
    fi
    echo "Today's wallpaper file is missing, picking a new one."
fi

touch "$USED_IDS"

chmod 600 "$USED_IDS"

if [[ ! -r "$API_KEY_FILE" ]]; then
    echo "Wallhaven API key not found: $API_KEY_FILE"
    exit 1
fi

API_KEY="$(< "$API_KEY_FILE")"

NOW="$(date +%s)"
CUTOFF=$(( NOW - BLOCK_DAYS * 86400 ))

# Rewrite the history: stamp old-format lines (id only) with the current
# time, and drop entries older than $BLOCK_DAYS.
awk -F'\t' -v now="$NOW" -v cutoff="$CUTOFF" '
    NF == 0 || $1 == "" { next }
    NF == 1 { print $1 "\t" now; next }
    $2 >= cutoff { print $1 "\t" $2 }
' "$USED_IDS" > "$USED_IDS.tmp"
mv "$USED_IDS.tmp" "$USED_IDS"
chmod 600 "$USED_IDS"

declare -A BLOCKED_YEAR=()
declare -A BLOCKED_RECENT=()

while IFS=$'\t' read -r id _; do
    [[ -n "$id" ]] && BLOCKED_YEAR["$id"]=1
done < "$USED_IDS"

while IFS=$'\t' read -r id _; do
    [[ -n "$id" ]] && BLOCKED_RECENT["$id"]=1
done < <(sort -t$'\t' -k2,2n "$USED_IDS" | tail -n "$FALLBACK_RECENT")

echo "Blocked for ${BLOCK_DAYS} days: ${#BLOCKED_YEAR[@]} wallpapers"

# At login the network may not be up yet; wait for wallhaven to be reachable.
waited=0
until curl -fsS --max-time 10 --proto '=https' --tlsv1.2 \
        -o /dev/null "https://wallhaven.cc"; do
    if (( waited >= NETWORK_WAIT_SECONDS )); then
        echo "Wallhaven not reachable after ${NETWORK_WAIT_SECONDS}s, giving up."
        exit 1
    fi
    sleep 3
    waited=$(( waited + 3 ))
done

# Without configured tags, search all of Wallhaven (empty tag id).
if (( ${#TAGS[@]} > 0 )); then
    SOURCES=("${TAGS[@]}")
else
    SOURCES=("All of Wallhaven|")
fi

search() {
    local tag_id="$1" page="$2" seed="${3:-}"
    local args=(
        --data "categories=$CATEGORIES"
        --data "purity=$PURITY"
        --data "sorting=random"
        --data "atleast=${MIN_WIDTH}x${MIN_HEIGHT}"
        --data "page=$page"
    )
    [[ -n "$tag_id" ]] && args+=(--data-urlencode "q=id:$tag_id")
    [[ -n "$RATIOS" ]] && args+=(--data "ratios=$RATIOS")
    [[ -n "$seed" ]] && args+=(--data "seed=$seed")

    curl -fsSL \
        --retry 2 \
        --retry-delay 2 \
        --proto '=https' \
        --tlsv1.2 \
        "$API" \
        -H "X-API-Key: $API_KEY" \
        --get \
        "${args[@]}"
}

# Try every source once. $1 = "year" or "recent": which blocklist to use.
# Returns 0 after setting a wallpaper, 1 if nothing usable was found.
pick_wallpaper() {
    local mode="$1"
    local list="BLOCKED_YEAR"
    [[ "$mode" == "recent" ]] && list="BLOCKED_RECENT"
    local -n blocked="$list"

    mapfile -t SHUFFLED < <(
        printf '%s\n' "${SOURCES[@]}" | shuf
    )

    for SELECTED in "${SHUFFLED[@]}"; do
        NAME="${SELECTED%%|*}"
        TAG_ID="${SELECTED##*|}"

        if [[ -n "$TAG_ID" && ! "$TAG_ID" =~ ^[0-9]+$ ]]; then
            echo
            echo "Skipping \"$SELECTED\": tag id must be a number (Name|1234)."
            continue
        fi

        echo
        echo "Searching: $NAME"

        if ! meta_json=$(search "$TAG_ID" 1); then
            echo "Search request failed for $NAME, skipping."
            continue
        fi

        total=$(jq -r '.meta.total // 0' <<< "$meta_json" 2>/dev/null || echo 0)
        last_page=$(jq -r '.meta.last_page // 1' <<< "$meta_json" 2>/dev/null || echo 1)
        seed=$(jq -r '.meta.seed // empty' <<< "$meta_json" 2>/dev/null || true)

        echo "Available wallpapers: $total"

        if (( total == 0 )) || [[ -z "$seed" ]]; then
            continue
        fi

        sample_count="$PAGE_SAMPLES"

        if (( sample_count > last_page )); then
            sample_count="$last_page"
        fi

        mapfile -t PAGES < <(
            seq 1 "$last_page" | shuf | head -n "$sample_count"
        )

        candidates_file="$(mktemp)"

        for page in "${PAGES[@]}"; do
            echo "Checking random page: $page/$last_page"

            if ! json=$(search "$TAG_ID" "$page" "$seed"); then
                echo "Page $page request failed, skipping."
                continue
            fi

            while IFS=$'\t' read -r \
                favorites \
                id \
                url \
                resolution \
                created_at; do

                [[ -z "$id" ]] && continue
                [[ -z "$url" ]] && continue
                [[ -n "${blocked[$id]:-}" ]] && continue

                printf '%s\t%s\t%s\t%s\t%s\n' \
                    "$favorites" \
                    "$id" \
                    "$url" \
                    "$resolution" \
                    "$created_at" \
                    >> "$candidates_file"

            done < <(
                jq -r '
                    .data[] |
                    [
                        .favorites,
                        .id,
                        .path,
                        .resolution,
                        .created_at
                    ] |
                    @tsv
                ' <<< "$json" 2>/dev/null
            )
        done

        candidate_count=$(wc -l < "$candidates_file")

        echo "Unused wallpapers sampled: $candidate_count"

        if (( candidate_count == 0 )); then
            rm -f "$candidates_file"
            continue
        fi

        keep_count=$(( candidate_count * QUALITY_PERCENT / 100 ))

        (( keep_count < 1 )) && keep_count=1

        quality_file="$(mktemp)"

        sort -t$'\t' -k1,1nr "$candidates_file" |
            head -n "$keep_count" |
            shuf > "$quality_file"

        rm -f "$candidates_file"

        while IFS=$'\t' read -r \
            favorites \
            id \
            url \
            resolution \
            created_at; do

            if [[ "$url" != https://wallhaven.cc/* && \
                  "$url" != https://w.wallhaven.cc/* ]]; then
                continue
            fi

            echo "Considering wallpaper: $id"

            file="$(mktemp "$DIR/wallpaper-XXXXXX.part")"

            if ! curl -fsS \
                --retry 2 \
                --retry-delay 2 \
                --proto '=https' \
                --tlsv1.2 \
                --max-redirs 0 \
                "$url" \
                -o "$file"; then
                rm -f "$file"
                continue
            fi

            mime_type="$(file --brief --mime-type "$file")"

            case "$mime_type" in
                image/jpeg) ext="jpg" ;;
                image/png)  ext="png" ;;
                image/webp) ext="webp" ;;
                *)
                    rm -f "$file"
                    continue
                    ;;
            esac

            final="${file%.part}.$ext"
            mv -- "$file" "$final"
            file="$final"

            echo
            echo "Selected wallpaper:"
            echo "  Source: $NAME"
            echo "  ID: $id"
            echo "  Resolution: $resolution"
            echo "  Favorites: $favorites"
            echo "  Uploaded: $created_at"

            gsettings set \
                org.gnome.desktop.background picture-uri \
                "file://$file"

            gsettings set \
                org.gnome.desktop.background picture-uri-dark \
                "file://$file"

            # Record (or refresh) this id with the current time.
            awk -F'\t' -v id="$id" '$1 != id' "$USED_IDS" > "$USED_IDS.tmp"
            printf '%s\t%s\n' "$id" "$(date +%s)" >> "$USED_IDS.tmp"
            mv "$USED_IDS.tmp" "$USED_IDS"
            chmod 600 "$USED_IDS"

            echo "Wallpaper set successfully."

            printf '%s\n' "$TODAY" > "$LAST_CHANGED"

            cleanup_old "$file"

            rm -f "$quality_file"

            return 0

        done < "$quality_file"

        rm -f "$quality_file"

        echo "No suitable wallpaper found for $NAME."

    done

    return 1
}

if pick_wallpaper year; then
    exit 0
fi

echo
echo "Every search is exhausted for the last ${BLOCK_DAYS} days;"
echo "falling back to avoiding only the last ${FALLBACK_RECENT} wallpapers."

if pick_wallpaper recent; then
    exit 0
fi

echo
echo "No suitable new wallpaper could be found."
exit 1
